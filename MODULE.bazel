"""fsla-results' build graph: its environment and its checks, on fsla-devtools' module (its environment extension and
generic rules). Nothing here names a machine; the front door (bazel/bazel) hands Bazel the machine's settings."""

module(name = "fsla_results")

bazel_dep(name = "bazel_skylib", version = "1.9.2")

#: THE GRAPH'S SHARED MACHINERY, fsla-devtools' module, at a public commit: the front door overrides it with the
#: machine's checkout (a fresh machine clones one at this commit first)
bazel_dep(name = "fsla_devtools", version = "0.1.0")
git_override(
    module_name = "fsla_devtools",
    commit = "7da5dde27158330ba07ccda5c962d2d04228425e",
    remote = "https://github.com/Blakexx/fsla-devtools.git",
)

#: THE ENVIRONMENT (fsla-devtools' environment extension): the pinned uv; `results_env`, the gate's linter beside
#: fsla_devtools (the verdict's statistics and the declaration check), the library itself standard library only; the
#: tracked tree
environment = use_extension("@fsla_devtools//bazel:environment.bzl", "environment")
environment.pinned(
    name = "uv",
    build = 'exports_files(["{binary}"], visibility = ["//visibility:public"])\n',
    pin = "@fsla_devtools//pins:uv_pin.json",
)
environment.python(
    name = "results_env",
    lock = "//:requirements.lock",
    uv = "@uv//:uv",
    uv_pin = "@fsla_devtools//pins:uv_pin.json",
)
environment.tree(name = "results_tree")
use_repo(environment, "results_env", "results_tree", "uv")
