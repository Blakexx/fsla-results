#!/usr/bin/env bash
# fsla-results' commit gate, in the tree: `core.hooksPath` points a checkout here (per worktree). It runs
# `bazel test //:gate` on the commit as git will write it (`fsla_devtools.graph.front_door`'s `commit_gate`, every FSLA
# repository's), through this workspace's front door.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/bazel/bazel" --tripwire --staged
exec "$root/bazel/bazel" --commit-gate
