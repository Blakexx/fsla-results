# fsla-results' graph settings: nothing here names a machine -- the machine's own settings (the shared disk and
# repository caches) come from the dev config, through the front door (bazel/bazel, fsla_devtools.graph.front_door).

# the server exits after 15 idle minutes, above the disk cache collector's 5-minute idle delay
startup --max_idle_secs=900

# the output links (`.bazel/bin`, `.bazel/out`, `.bazel/testlogs`) all under one ignored directory, so the checkout's root holds none
# of them; a file nothing commits is a build output there, never written into the checkout
build --symlink_prefix=.bazel/

# THE TOOLS' CACHES NEVER LAND IN A CHECKOUT: a target that runs a tool in the source tree writes no bytecode and no ruff
# cache there; pytest's and hypothesis's are off in the tool's own config (pyproject.toml, tests/conftest.py)
run  --run_env=PYTHONDONTWRITEBYTECODE=1 --run_env=RUFF_NO_CACHE=true
test --test_env=PYTHONDONTWRITEBYTECODE=1 --test_env=RUFF_NO_CACHE=true

# the shared disk cache's bound
common --experimental_disk_cache_gc_max_size=5G
