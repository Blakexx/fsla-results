"""fsla-results' root package: its checks and gate over the data (the tracked tree beside them: records/ holds no BUILD
file, so its files are this package's), the records' index as a build output, and the store's command line."""

load("@fsla_devtools//bazel:hermetic.bzl", "hermetic_test")
load("@fsla_devtools//bazel:rules.bzl", "bazel_version_test")
load("@fsla_devtools//bazel:results.bzl", "results_index")
load("@results_env//:flags.bzl", "VENV")
load("//bazel:defs.bzl", "docrefs_test", "results_run", "tree_part", "tree_test")

exports_files(["requirements.lock"])

#: this package's part of the tree, and the whole tree
tree_part()

filegroup(
    name = "tree",
    srcs = [
        ":tracked",
        "//bazel:tracked",
    ],
)

#: every stored sample consistent (fsla_devtools.results' own check): a file under its producing target's label, its key
#: recomputing from its semantics, its output and parts present, no lock file in the tree
tree_test(
    name = "records",
    size = "small",
    cmd = ["python3", "-m", "fsla_devtools.results", "--root", "records", "check"],
    data = [":tree"],
)

tree_test(
    name = "declarations",
    size = "small",
    cmd = ["python3", "-m", "fsla_devtools.mirror", "--check"],
    data = [":tree"],
    git = True,
)

#: every citation the README makes of the tree pinned and read (fsla-devtools' `fsla_devtools.docrefs`); the data holds
#: no Python package, so a citation is a path, a link, or a path of the pinned data -- which, here, is this checkout
docrefs_test(
    name = "docrefs",
    size = "small",
    data = "//:MODULE.bazel",
    lock = "references.lock.json",
)

#: .bazelversion is the Bazel release fsla-devtools' shared pins are tested with
bazel_version_test(
    name = "bazelversion",
    version = ".bazelversion",
)

#: THE HERMETIC CHECK (fsla-devtools' `hermetic_test`): the gate's checks, the records' index and the store's command line
#: read whole -- no machine path, no machine tool but fsla-devtools' default allowlist's -- with the lockfile, `.bazelrc`
#: and the repository rules' Starlark
hermetic_test(
    name = "hermetic",
    size = "small",
    targets = [
        ":bazelversion",
        ":declarations",
        ":docrefs",
        ":index",
        ":records",
        ":results",
    ],
    venv = VENV,
)

#: THE GATE: every check this workspace holds; the commit hook runs it (.githooks/pre-commit)
test_suite(
    name = "gate",
    tests = [
        ":bazelversion",
        ":declarations",
        ":docrefs",
        ":hermetic",
        ":records",
    ],
)

#: THE RECORDS' INDEX, derived: a build output (`bazel build //:index`), never a file beside the records
results_index(
    name = "index",
    directory = "records",
    records = [":tracked"],
    venv = VENV,
)

#: the store's command line (README.md): `bazel run //:results -- --root records check|show|index|sql|history|latest|...`
results_run(
    name = "results",
    module = "fsla_devtools.results",
)
